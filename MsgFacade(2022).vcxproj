  </PropertyGroup>

  <!-- Stage the kernel DLL the facade loads at run time into the shared output
       folder, keyed by $(Configuration)$(PlatformArchitecture) so Win32 draws
       from bin\Debug32 / bin\Release32 and x64 from bin\Debug64 / bin\Release64. -->
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <Command>xcopy /Y "$(MSBuildThisFileDirectory)..\bin\$(Configuration)$(PlatformArchitecture)\Msgcore.dll" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

