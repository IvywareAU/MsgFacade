  <PropertyGroup Label="UserMacros" />

  <!-- One output root for this project and everything that consumes it, so a
       variant is one folder rather than several scattered ones, and each
       executable lands next to the DLLs it loads.  Anchored on
       $(MSBuildThisFileDirectory), not $(SolutionDir): the path must not depend
       on which solution drives the build. -->
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)out\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)out\$(Platform)\$(Configuration)\obj\$(ProjectName)\</IntDir>
  </PropertyGroup>

