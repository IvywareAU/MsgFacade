  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="MsgcoreCom.rc" />
    <None Include="MsgStore.rgs" />
    <None Include="MsgcoreCom.def" />
  </ItemGroup>

  <!-- Two DLLs must sit next to this server for regsvr32 to be able to load it:
       MsgFacade.dll, which it links, and Msgcore.dll, which that links and which
       is an MFC extension DLL and so is never linked statically.

       Staged here rather than left to PATH: a registered in-proc server is
       loaded by whatever process CoCreates it, and that process's PATH is not
       ours. COM loads an in-proc server with LOAD_WITH_ALTERED_SEARCH_PATH, so
       the copies BESIDE THE SERVER are the ones that get used.

       A missing DLL would otherwise show up only as 0xC06D007E when regsvr32
       loads the server, which is a long way from the cause, so both are errors
       here, after the link, where the message can say what to build. -->
  <Target Name="StageDependencies" AfterTargets="Build">
    <PropertyGroup>
      <FacadeBin>$(MSBuildThisFileDirectory)..\out\$(Platform)\$(Configuration)</FacadeBin>
      <!-- The facade stages its own Msgcore.dll beside itself, so that is the
           first place to look and the one that matches what was just built. -->
      <MsgcoreBin Condition="Exists('$(FacadeBin)\Msgcore.dll')">$(FacadeBin)</MsgcoreBin>
      <MsgcoreBin Condition="'$(MsgcoreBin)'=='' and Exists('$(MSBuildThisFileDirectory)..\..\Msgcore\out\$(Platform)\$(Configuration)\Msgcore.dll')">$(MSBuildThisFileDirectory)..\..\Msgcore\out\$(Platform)\$(Configuration)</MsgcoreBin>
      <MsgcoreBin Condition="'$(MsgcoreBin)'=='' and Exists('$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)64\Msgcore.dll')">$(MSBuildThisFileDirectory)..\..\bin\$(Configuration)64</MsgcoreBin>
    </PropertyGroup>
    <Error Condition="!Exists('$(FacadeBin)\MsgFacade.dll')"
           Text="MsgFacade.dll not found in '$(FacadeBin)'. Build MsgFacade(2022).vcxproj for $(Configuration)|$(Platform) first -- this server links it and cannot load without it." />
    <Error Condition="'$(MsgcoreBin)'==''"
           Text="Msgcore.dll not found. Looked beside MsgFacade.dll, in Msgcore\out\$(Platform)\$(Configuration) and in bin\$(Configuration)64. Build Msgcore(2022).vcxproj for $(Configuration)|$(Platform) first." />
    <Copy SourceFiles="$(FacadeBin)\MsgFacade.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MsgcoreBin)\Msgcore.dll"  DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
